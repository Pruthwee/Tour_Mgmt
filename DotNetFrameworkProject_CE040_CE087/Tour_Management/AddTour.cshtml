@page
@model Tour_Management.Pages.AddTourModel
@{
    ViewData["Title"] = "Add New Tour";
}

<!DOCTYPE html>
<html>
<head>
    <title>Add New Tour</title>
    <style type="text/css">
        .page-header {
            text-align: center;
        }
        .form-horizontal {
            font-size: 30px;
            text-align: center;
        }
        .row .form-horizontal {
            border-right: 1px double;
        }
        .container {
            text-align: center;
            background-color: black;
            width: 100%;
            font-size: 30px;
            color: white;
            padding-bottom: 150px;
            opacity: 0.8;
        }
    </style>
</head>
<body>
    <div class="page-header">
        <h1>Add New Tour</h1>
    </div>
    <div class="container">
        <div class="row">
            <div class="form-horizontal col-md-7">
                <form method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <div class="control-label col-sm-3">
                            <label>Name of Tour</label>
                        </div>
                        <div class="col-sm-6">
                            <input asp-for="TourName" required class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="control-label col-sm-3">
                            <label>Place</label>
                        </div>
                        <div class="col-sm-6">
                            <input asp-for="Place" required class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="control-label col-sm-3">
                            <label>Days</label>
                        </div>
                        <div class="col-sm-6">
                            <input asp-for="Days" required class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="control-label col-sm-3">
                            <label>Locations</label>
                        </div>
                        <div class="col-sm-6">
                            <input asp-for="Locations" required class="form-control" />
                        </div>
                    </div>

                    <div class="col-md-5">
                        <p style="text-align:center; font-size:30px">Image for Tour</p>
                        <input asp-for="TourPic" type="file" class="form-control" />
                    </div>

                    <div class="form-group">
                        <div class="control-label col-sm-3">
                            <label>Price</label>
                        </div>
                        <div class="col-sm-6">
                            <input asp-for="Price" required class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="control-label col-sm-3">
                            <label>Tour Info</label>
                        </div>
                        <div class="col-sm-6">
                            <textarea asp-for="TourInfo" required class="form-control"></textarea>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="control-label col-sm-3">
                            <button type="submit" class="btn btn-primary" style="background-color:#cc6600; color:black;">Register</button>
                        </div>
                        <div class="control-label col-sm-3">
                            <button type="reset" class="btn btn-secondary" style="background-color:#cc6600; color:black;">Reset</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
