<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud-readiness (cr-dotnet-0010): This Web.config transformation file is DEPRECATED
  for cloud deployments. Environment-specific configuration is now managed via:
    - Environment variables injected at runtime (DB_CONNECTION_STRING, ADMIN_EMAIL, ADMIN_PASSWORD)
    - AWS Systems Manager Parameter Store for secure/sensitive values
    - AWS Secrets Manager for credentials

  This file is retained only for local development compatibility.
  In AWS deployments (ECS, Elastic Beanstalk, EC2), do NOT rely on XDT transformations.
  Instead, inject all configuration as environment variables at instance/container startup.

  For production AWS deployments:
    1. Store DB_CONNECTION_STRING in AWS Systems Manager Parameter Store as SecureString
       at path: /tour-management/prod/db-connection-string
    2. Store ADMIN_EMAIL and ADMIN_PASSWORD in AWS Secrets Manager
    3. Inject these as environment variables via ECS task definition or Elastic Beanstalk
       environment properties - no build-time transformation required.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
