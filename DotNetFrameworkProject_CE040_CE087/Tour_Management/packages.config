<?xml version="1.0" encoding="utf-8"?>
<packages>
  <package id="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" version="2.0.1" targetFramework="net472" />
  <!-- Cloud-readiness (cr-dotnet-0013): Added Dapper for lightweight ORM with Amazon RDS Proxy support.
       Dapper provides connection pooling-friendly data access patterns compatible with RDS Proxy. -->
  <package id="Dapper" version="2.1.35" targetFramework="net472" />
  <!-- Cloud-readiness (cr-dotnet-0013): Added Microsoft.Data.SqlClient as the modern SQL Server
       client driver. Supports IAM authentication and is compatible with Amazon RDS Proxy. -->
  <package id="Microsoft.Data.SqlClient" version="5.2.2" targetFramework="net472" />
</packages>
