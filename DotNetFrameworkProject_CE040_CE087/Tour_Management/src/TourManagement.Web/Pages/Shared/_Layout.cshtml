<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tour Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header><nav class="navbar navbar-expand-sm navbar-dark bg-primary"><div class="container"><a class="navbar-brand" asp-page="/Index">Tour Management</a><div class="navbar-nav"><a class="nav-link" asp-page="/Tours/Index">Tours</a><a class="nav-link" asp-page="/Bookings/Index">Bookings</a><a class="nav-link" asp-page="/Customers/Index">Customers</a></div></div></nav></header>
<main class="container py-4">@RenderBody()</main>
<footer class="border-top footer text-muted"><div class="container">Modernized to .NET 8</div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
