@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{ ViewData["Title"] = "Tour Details"; }
<h1>@Model.Tour?.Name</h1><dl class="row"><dt class="col-sm-2">Place</dt><dd class="col-sm-10">@Model.Tour?.Place</dd><dt class="col-sm-2">Days</dt><dd class="col-sm-10">@Model.Tour?.Days</dd><dt class="col-sm-2">Price</dt><dd class="col-sm-10">@Model.Tour?.Price.ToString("C")</dd><dt class="col-sm-2">Locations</dt><dd class="col-sm-10">@Model.Tour?.Locations</dd><dt class="col-sm-2">Description</dt><dd class="col-sm-10">@Model.Tour?.Description</dd></dl><a asp-page="Index" class="btn btn-secondary">Back</a>
