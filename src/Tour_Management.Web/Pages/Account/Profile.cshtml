@page
@model Tour_Management.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

@if (Model.Profile != null)
{
    <div class="row">
        <div class="col-md-5">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Personal Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Profile.FirstName @Model.Profile.LastName</dd>
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Profile.Email</dd>
                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">@Model.Profile.Gender</dd>
                        <dt class="col-sm-4">Date of Birth</dt>
                        <dd class="col-sm-8">@Model.Profile.Dob.ToString("dd MMM yyyy")</dd>
                        <dt class="col-sm-4">Address</dt>
                        <dd class="col-sm-8">@Model.Profile.Street, @Model.Profile.City, @Model.Profile.State</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">My Bookings</h5>
                </div>
                <div class="card-body">
                    @if (Model.Profile.Bookings.Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Tour</th>
                                    <th>Place</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in Model.Profile.Bookings)
                                {
                                    <tr>
                                        <td>@booking.TourName</td>
                                        <td>@booking.Place</td>
                                        <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No bookings yet. <a asp-page="/Tours/Index">Browse tours</a> to book one!</p>
                    }
                </div>
            </div>
        </div>
    </div>
}
