@page
@model Tour_Management.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>
<hr />

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-primary shadow">
            <div class="card-body text-center">
                <h2>@Model.TotalTours</h2>
                <p class="card-text">Total Tours</p>
                <a asp-page="/Tours/Index" class="btn btn-light btn-sm">Manage Tours</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-success shadow">
            <div class="card-body text-center">
                <h2>@Model.TotalBookings</h2>
                <p class="card-text">Total Bookings</p>
                <a asp-page="/Bookings/Index" class="btn btn-light btn-sm">View Bookings</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-info shadow">
            <div class="card-body text-center">
                <h2>@Model.TotalUsers</h2>
                <p class="card-text">Registered Users</p>
                <a asp-page="/Users/Index" class="btn btn-light btn-sm">Manage Users</a>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-warning shadow">
            <div class="card-body text-center">
                <h2>+</h2>
                <p class="card-text">Add New Tour</p>
                <a asp-page="/Tours/Create" class="btn btn-light btn-sm">Add Tour</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">Quick Actions</div>
            <div class="card-body">
                <a asp-page="/Tours/Create" class="btn btn-success mb-2 w-100">Add New Tour</a>
                <a asp-page="/Bookings/Index" class="btn btn-primary mb-2 w-100">View All Bookings</a>
                <a asp-page="/Users/Index" class="btn btn-info mb-2 w-100">Manage Users</a>
            </div>
        </div>
    </div>
</div>
