@page "{id:int}"
@model Tour_Management.Web.Pages.Admin.Tours.DeleteModel
@{
    ViewData["Title"] = "Delete Tour";
}

<h2>Delete Tour</h2>
<div class="alert alert-warning">
    <strong>Are you sure you want to delete this tour?</strong>
</div>

@if (Model.Tour != null)
{
    <div class="card shadow mb-3">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Tour Name</dt>
                <dd class="col-sm-9">@Model.Tour.TourName</dd>
                <dt class="col-sm-3">Place</dt>
                <dd class="col-sm-9">@Model.Tour.Place</dd>
                <dt class="col-sm-3">Days</dt>
                <dd class="col-sm-9">@Model.Tour.Days</dd>
                <dt class="col-sm-3">Price</dt>
                <dd class="col-sm-9">₹@Model.Tour.Price.ToString("N0")</dd>
            </dl>
        </div>
    </div>
    <form method="post">
        <input type="hidden" name="id" value="@Model.Tour.TourId" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-page="/Admin/Tours/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
}
