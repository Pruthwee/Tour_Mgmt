@page
@model Tour_Management.Web.Pages.Admin.Tours.IndexModel
@{
    ViewData["Title"] = "Manage Tours";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Manage Tours</h2>
    <a asp-page="/Admin/Tours/Create" class="btn btn-success">+ Add New Tour</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tour Name</th>
            <th>Place</th>
            <th>Days</th>
            <th>Price</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tour in Model.Tours)
        {
            <tr>
                <td>@tour.TourId</td>
                <td>@tour.TourName</td>
                <td>@tour.Place</td>
                <td>@tour.Days</td>
                <td>₹@tour.Price.ToString("N0")</td>
                <td>@(tour.IsActive ? "✅" : "❌")</td>
                <td>
                    <a asp-page="/Admin/Tours/Edit" asp-route-id="@tour.TourId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-page="/Admin/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                    <a asp-page="/Admin/Tours/Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
