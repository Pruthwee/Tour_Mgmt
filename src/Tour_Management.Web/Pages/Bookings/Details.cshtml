@page "{id:int}"
@model Tour_Management.Web.Pages.Bookings.DetailsModel
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>
<hr />

@if (Model.Booking != null)
{
    <dl class="row">
        <dt class="col-sm-3">Booking ID</dt>
        <dd class="col-sm-9">@Model.Booking.BookingId</dd>
        <dt class="col-sm-3">Tour Name</dt>
        <dd class="col-sm-9">@Model.Booking.TourName</dd>
        <dt class="col-sm-3">Customer Name</dt>
        <dd class="col-sm-9">@Model.Booking.FirstName</dd>
        <dt class="col-sm-3">City</dt>
        <dd class="col-sm-9">@Model.Booking.Place</dd>
        <dt class="col-sm-3">Mobile/Email</dt>
        <dd class="col-sm-9">@Model.Booking.Email</dd>
        <dt class="col-sm-3">Booking Date</dt>
        <dd class="col-sm-9">@Model.Booking.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.Booking.IsActive ? "Active" : "Cancelled")</dd>
    </dl>

    <a asp-page="./MyBookings" class="btn btn-secondary">Back to My Bookings</a>
    @if (HttpContext.Session.GetString("IsAdmin") == "true")
    {
        <a asp-page="./Edit" asp-route-id="@Model.Booking.BookingId" class="btn btn-primary ms-2">Edit</a>
        <a asp-page="./Delete" asp-route-id="@Model.Booking.BookingId" class="btn btn-danger ms-2">Delete</a>
    }
}
else
{
    <div class="alert alert-warning">Booking not found.</div>
    <a asp-page="./MyBookings" class="btn btn-secondary">Back to My Bookings</a>
}
