@page
@model Tour_Management.Web.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<h2>My Bookings</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (Model.Bookings.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th>Tour Name</th>
                <th>Place</th>
                <th>Booking Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model.Bookings)
            {
                <tr>
                    <td>@booking.BookingId</td>
                    <td>@booking.TourName</td>
                    <td>@booking.Place</td>
                    <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                    <td>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@booking.BookingId" onsubmit="return confirm('Cancel this booking?')">
                            <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        You have no bookings yet. <a asp-page="/Tours/Index">Browse tours</a> to book one!
    </div>
}
