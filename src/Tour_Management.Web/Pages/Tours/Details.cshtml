@page "{id:int}"
@model Tour_Management.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = Model.Tour?.TourName ?? "Tour Details";
}

@if (Model.Tour != null)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Tours/Index">Tours</a></li>
            <li class="breadcrumb-item active">@Model.Tour.TourName</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="~/images/tours/@Model.Tour.Pic" class="img-fluid rounded shadow" alt="@Model.Tour.TourName" onerror="this.src='/images/default-tour.jpg'" />
            }
            else
            {
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height:300px;">
                    <span class="text-white" style="font-size:5rem;">🌍</span>
                </div>
            }
        </div>
        <div class="col-md-6">
            <h2>@Model.Tour.TourName</h2>
            <p class="lead text-muted">📍 @Model.Tour.Place</p>
            <hr />
            <dl class="row">
                <dt class="col-sm-4">Duration</dt>
                <dd class="col-sm-8">@Model.Tour.Days days</dd>
                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8 text-success fw-bold">₹@Model.Tour.Price.ToString("N0")</dd>
                <dt class="col-sm-4">Locations</dt>
                <dd class="col-sm-8">@Model.Tour.Locations</dd>
            </dl>
            <h5>About this Tour</h5>
            <p>@Model.Tour.TourInfo</p>
            <div class="d-flex gap-2 mt-3">
                <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.TourId" class="btn btn-success btn-lg">Book Now</a>
                <a asp-page="/Tours/Index" class="btn btn-outline-secondary">Back to Tours</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Tour not found. <a asp-page="/Tours/Index">Browse all tours</a></div>
}
