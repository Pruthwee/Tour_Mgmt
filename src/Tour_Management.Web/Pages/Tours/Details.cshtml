@page
@model Tour_Management.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

@if (Model.Tour == null)
{
    <div class="alert alert-warning">Tour not found.</div>
    <a asp-page="./Index" class="btn btn-secondary">Back to Tours</a>
}
else
{
    <h1>@Model.Tour.TourName</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(Model.Tour.Pic))
            {
                <img src="/Tour_pics/@Model.Tour.Pic" class="img-fluid rounded" alt="@Model.Tour.TourName" style="max-height:400px; object-fit:cover;" />
            }
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Place</dt>
                <dd class="col-sm-8">@Model.Tour.Place</dd>
                <dt class="col-sm-4">Days</dt>
                <dd class="col-sm-8">@Model.Tour.Days</dd>
                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">&#8377;@Model.Tour.Price.ToString("N2")</dd>
                <dt class="col-sm-4">Locations</dt>
                <dd class="col-sm-8">@Model.Tour.Locations</dd>
                <dt class="col-sm-4">Tour Info</dt>
                <dd class="col-sm-8">@Model.Tour.TourInfo</dd>
            </dl>
            <div class="mt-3">
                <a asp-page="/Bookings/Create" asp-route-tourName="@Model.Tour.TourName" class="btn btn-warning">Book Now</a>
                <a asp-page="./Index" class="btn btn-secondary ms-2">Back to Tours</a>
                @if (HttpContext.Session.GetString("IsAdmin") == "true")
                {
                    <a asp-page="./Edit" asp-route-id="@Model.Tour.TourId" class="btn btn-primary ms-2">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@Model.Tour.TourId" class="btn btn-danger ms-2">Delete</a>
                }
            </div>
        </div>
    </div>
}
