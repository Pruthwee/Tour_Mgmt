@page
@model Tour_Management.Web.Pages.Tours.IndexModel
@{
    ViewData["Title"] = "Tours";
}

<h1>Available Tours</h1>

@if (!string.IsNullOrEmpty(Model.SearchTerm))
{
    <p>Search results for: <strong>@Model.SearchTerm</strong> <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Clear</a></p>
}

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search tours by name or place..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (HttpContext.Session.GetString("IsAdmin") == "true")
{
    <a asp-page="./Create" class="btn btn-success mb-3">Add New Tour</a>
}

@if (!Model.Tours.Any())
{
    <div class="alert alert-info">No tours found.</div>
}
else
{
    <div class="row">
        @foreach (var tour in Model.Tours)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow">
                    @if (!string.IsNullOrEmpty(tour.Pic))
                    {
                        <img src="/Tour_pics/@tour.Pic" class="card-img-top" alt="@tour.TourName" style="height:200px; object-fit:cover;" onerror="this.src=''" />
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;">
                            <span class="text-white">No Image</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@tour.TourName</h5>
                        <p class="card-text">
                            <strong>Place:</strong> @tour.Place<br />
                            <strong>Days:</strong> @tour.Days<br />
                            <strong>Price:</strong> &#8377;@tour.Price.ToString("N2")<br />
                            <strong>Locations:</strong> @tour.Locations
                        </p>
                    </div>
                    <div class="card-footer">
                        <a asp-page="./Details" asp-route-id="@tour.TourId" class="btn btn-info btn-sm">Details</a>
                        <a asp-page="/Bookings/Create" asp-route-tourName="@tour.TourName" class="btn btn-warning btn-sm">Book Now</a>
                        @if (HttpContext.Session.GetString("IsAdmin") == "true")
                        {
                            <a asp-page="./Edit" asp-route-id="@tour.TourId" class="btn btn-primary btn-sm">Edit</a>
                            <a asp-page="./Delete" asp-route-id="@tour.TourId" class="btn btn-danger btn-sm">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
