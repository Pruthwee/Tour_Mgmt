@page "{id:int}"
@model Tour_Management.Web.Pages.Users.EditModel
@{
    ViewData["Title"] = "Edit User";
}

<h1>Edit User</h1>
<hr />

<div class="row">
    <div class="col-md-7">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="User.UserInfoId" />

            <div class="mb-3">
                <label asp-for="User.Email" class="form-label"></label>
                <input asp-for="User.Email" class="form-control" type="email" />
                <span asp-validation-for="User.Email" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="User.FirstName" class="form-label"></label>
                    <input asp-for="User.FirstName" class="form-control" />
                    <span asp-validation-for="User.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="User.LastName" class="form-label"></label>
                    <input asp-for="User.LastName" class="form-control" />
                    <span asp-validation-for="User.LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="User.Gender" class="form-label"></label>
                <select asp-for="User.Gender" class="form-select">
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span asp-validation-for="User.Gender" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="User.Dob" class="form-label"></label>
                <input asp-for="User.Dob" class="form-control" type="date" />
            </div>

            <div class="mb-3">
                <label asp-for="User.Street" class="form-label"></label>
                <input asp-for="User.Street" class="form-control" />
                <span asp-validation-for="User.Street" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="User.City" class="form-label"></label>
                    <input asp-for="User.City" class="form-control" />
                    <span asp-validation-for="User.City" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="User.State" class="form-label"></label>
                    <input asp-for="User.State" class="form-control" />
                    <span asp-validation-for="User.State" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input asp-for="User.IsActive" class="form-check-input" type="checkbox" />
                    <label asp-for="User.IsActive" class="form-check-label">Active</label>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-page="./Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
