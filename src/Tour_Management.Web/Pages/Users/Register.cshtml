@page
@model Tour_Management.Web.Pages.Users.RegisterModel
@{
    ViewData["Title"] = "User Registration";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow mt-4">
            <div class="card-header bg-dark text-white text-center">
                <h3>User Registration Form</h3>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Register.Email" class="form-label"></label>
                        <input asp-for="Register.Email" class="form-control" type="email" />
                        <span asp-validation-for="Register.Email" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Register.FirstName" class="form-label"></label>
                            <input asp-for="Register.FirstName" class="form-control" />
                            <span asp-validation-for="Register.FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Register.LastName" class="form-label"></label>
                            <input asp-for="Register.LastName" class="form-control" />
                            <span asp-validation-for="Register.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Register.Gender" class="form-label"></label>
                        <select asp-for="Register.Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Register.Gender" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Register.Password" class="form-label"></label>
                        <input asp-for="Register.Password" class="form-control" type="password" />
                        <span asp-validation-for="Register.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Register.ConfirmPassword" class="form-label"></label>
                        <input asp-for="Register.ConfirmPassword" class="form-control" type="password" />
                        <span asp-validation-for="Register.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Register.Dob" class="form-label"></label>
                        <input asp-for="Register.Dob" class="form-control" type="date" />
                        <span asp-validation-for="Register.Dob" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Register.Street" class="form-label"></label>
                        <input asp-for="Register.Street" class="form-control" />
                        <span asp-validation-for="Register.Street" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Register.City" class="form-label"></label>
                            <input asp-for="Register.City" class="form-control" />
                            <span asp-validation-for="Register.City" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Register.State" class="form-label"></label>
                            <input asp-for="Register.State" class="form-control" />
                            <span asp-validation-for="Register.State" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">Register</button>
                        <a asp-page="./Login" class="btn btn-outline-secondary">Already have an account? Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
